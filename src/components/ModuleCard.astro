---
interface Props {
  module: import('../utils/systems.ts').Module;
}
const { module } = Astro.props;
const domainSlug = module.domain.toLowerCase().replace(/\s+/g, '-').replace(/&/g, '');
---
<article class="module-card group relative bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:border-primary-500 transition-all" data-domain={domainSlug}>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-2">
        <h3 class="font-semibold text-gray-900 dark:text-white truncate">{module.name}</h3>
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${module.stage === 'live' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' : module.stage === 'pilot' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400' : module.stage === 'dev' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400' : module.stage === 'concept' ? 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300' : 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400'}`}>
          {module.stage.charAt(0).toUpperCase() + module.stage.slice(1)}
        </span>
        <span class={`w-2 h-2 rounded-full ${module.health === 'healthy' ? 'bg-green-500' : module.health === 'degraded' ? 'bg-amber-500' : module.health === 'critical' ? 'bg-red-500' : 'bg-gray-400'}`} title={module.health}></span>
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-4">{module.description}</p>
      
      {Object.keys(module.metrics).length > 0 && (
        <div class="metrics-grid grid grid-cols-2 gap-2 mb-4 text-xs">
          {Object.entries(module.metrics).map(([key, value]) => (
            <div class="flex justify-between px-2 py-1 bg-gray-50 dark:bg-gray-800 rounded">
              <span class="text-gray-500 dark:text-gray-400">{key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase())}</span>
              <span class="font-mono font-medium text-gray-900 dark:text-white">{value}</span>
            </div>
          ))}
        </div>
      )}
      
      <div class="flex items-center gap-2 flex-wrap">
        {module.tags.slice(0, 4).map(tag => (
          <span class="px-2 py-0.5 text-xs bg-gray-100 dark:bg-gray-800 rounded-full text-gray-700 dark:text-gray-300">{tag}</span>
        ))}
        {module.tags.length > 4 && <span class="text-xs text-gray-500">+{module.tags.length - 4}</span>}
      </div>
    </div>
    
    <div class="flex flex-col items-end gap-2 shrink-0">
      <a href={module.repo} target="_blank" rel="noopener" class="text-sm text-primary-600 dark:text-primary-400 hover:underline flex items-center gap-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
      {module.deployUrl && (
        <a href={module.deployUrl} target="_blank" rel="noopener" class="text-sm text-green-600 dark:text-green-400 hover:underline flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Live
        </a>
      )}
    </div>
  </div>
  
  <div class="absolute bottom-2 right-2 text-xs text-gray-400 font-mono">
    Updated: {module.lastDeploy ? new Date(module.lastDeploy).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'}
  </div>
</article>