---
interface Props {
  lastUpdated?: string;
}
const { lastUpdated = new Date().toISOString() } = Astro.props;
---
<div class="flex items-center gap-3">
  <span class="text-sm text-gray-500 dark:text-gray-400">Last updated:</span>
  <time class="text-sm font-mono text-gray-700 dark:text-gray-300" datetime={lastUpdated}>
    {new Date(lastUpdated).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })}
  </time>
</div>