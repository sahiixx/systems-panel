---
interface Props {
  summary: import('../../utils/systems').SystemsData['summary'];
}
const { summary } = Astro.props;
---
<div class="summary-stats grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Total Modules</p>
    <p class="text-3xl font-bold font-mono text-gray-900 dark:text-white mt-1">{summary.total}</p>
  </div>
  <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Core Systems</p>
    <p class="text-3xl font-bold font-mono text-primary-600 dark:text-primary-400 mt-1">{summary.coreCount}</p>
  </div>
  <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Aggregate Uptime</p>
    <p class="text-3xl font-bold font-mono text-green-600 dark:text-green-400 mt-1">{summary.aggregateMetrics?.totalUptime || '99.5%'}</p>
  </div>
  <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Tasks/Day (Agency)</p>
    <p class="text-3xl font-bold font-mono text-gray-900 dark:text-white mt-1">{(summary.aggregateMetrics?.totalTasksPerDay || 1247).toLocaleString()}</p>
  </div>
</div>