---
interface Props {
  stage: 'live' | 'pilot' | 'dev' | 'concept' | 'reference';
}
const { stage } = Astro.props;
---
<span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
  stage === 'live' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' :
  stage === 'pilot' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400' :
  stage === 'dev' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400' :
  stage === 'concept' ? 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300' :
  'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400'
}`}>
  {stage.charAt(0).toUpperCase() + stage.slice(1)}
</span>